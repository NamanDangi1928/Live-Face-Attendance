@app.post("/api/enroll-face-mongodb/{student_id}")
async def enroll_face_mongodb(
    student_id: str,
    face_image: UploadFile = File(...)
):
    # Enroll student's face in MongoDB (supports 3-step)
    try:
        # Read image
        contents = await face_image.read()
        nparr = np.frombuffer(contents, np.uint8)
        image = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        
        if image is None:
            raise HTTPException(status_code=400, detail="Invalid image")
        
        # Save to DB (Just marking as enrolled, no embedding for LBPH)
        # Note: Ideally we should save the image to disk here too if we want persistence
        # For now, we'll assume the client handles file uploading separately or this is a metadata sync
        dummy_embedding = np.array([])
        success = await mongodb.add_face_embedding(student_id, dummy_embedding)
        
        # Update in-memory recognizer
        # We need to fetch student details again to be safe
        student = await mongodb.get_student_by_id(student_id)
        if student:
            face_recognizer.enroll_student(
                str(student["_id"]), 
                student["name"], 
                student["roll_number"], 
                image # This updates the in-memory embedding
            )
            
        return {"success": True, "message": "Face enrolled"}
        
    except Exception as e:
        logger.error(f"Error enrolling face (MongoDB): {e}")
        return {"success": False, "message": str(e)}


@app.post("/api/enroll-with-files")
async def enroll_with_files(
    name: str = Form(...),
    roll_number: str = Form(...),
    email: str = Form(None),
    phone: str = Form(None),
    images: List[UploadFile] = File(...)
):
    """Enroll student with multiple images (Average embedding)"""
    try:
        # 1. Create Student in MongoDB
        student = await mongodb.create_student(name, roll_number, email, phone)
        student_id = str(student["_id"])
        
        valid_embeddings = []
        saved_crop_path = None
        best_face_img = None
        
        # 2. Process Images
        for idx, file in enumerate(images):
            if idx >= 3: break
            
            contents = await file.read()
            nparr = np.frombuffer(contents, np.uint8)
            img = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
            
            if img is not None:
                # Detect face (Crop)
                detections = face_detector.detect(img)
                if not detections:
                    print(f"No face detected in image {idx}")
                    continue
                
                # Take largest face
                det = max(detections, key=lambda d: d.width * d.height)
                
                # Crop with padding
                face_crop = face_detector.extract_face(img, det)
                if face_crop is None: continue

                # Save first valid crop as reference
                if saved_crop_path is None:
                    crop_filename = f"{student_id}_ref.jpg"
                    crop_path = config.STUDENTS_DIR / crop_filename
                    cv2.imwrite(str(crop_path), face_crop)
                    saved_crop_path = str(crop_path)
                    best_face_img = face_crop
                
                # Compute Embedding
                embedding = face_recognizer.get_embedding(face_crop)
                if embedding is not None:
                    valid_embeddings.append(embedding)

        if not valid_embeddings:
             # Rollback? Or just warn?
             return JSONResponse(status_code=400, content={"success": False, "message": "No valid faces recognized in uploaded images."})
        
        # 3. Average Embeddings
        # Stack them: (N, 1, 128) -> (N, 128)
        # SFace embeddings are (1, 128) usually
        stacked = np.vstack(valid_embeddings)
        mean_embedding = np.mean(stacked, axis=0) # (128,)
        
        # Normalize (CosSim requires unit vectors for best results)
        norm = np.linalg.norm(mean_embedding)
        if norm > 0:
            mean_embedding = mean_embedding / norm
            
        # Reshape to (1, 128) to match standard SFace output
        final_embedding = mean_embedding.reshape(1, 128)
        
        # 4. Store Single Averaged Embedding
        await mongodb.add_face_embedding(student_id, final_embedding, saved_crop_path)
        

        if best_face_img is not None and final_embedding is not None:
            # Remove existing in-memory embeddings for this student.
            face_recognizer._enrolled_faces = [
                face for face in face_recognizer._enrolled_faces
                if str(face["student_id"]) != str(student_id)
            ]

            # Add the averaged enrollment embedding once.
            face_recognizer._enrolled_faces.append({
                "embedding": np.asarray(
                    final_embedding, dtype=np.float32
                ).flatten(),
                "student_id": str(student_id),
                "name": name,
                "roll_number": roll_number,
                "filename": "avg_enrollment"
            })

            # Synchronize the matching matrix and student information.
            face_recognizer._rebuild_embedding_matrix()

        return {
            "success": True,
            "message": f"Student enrolled with {len(valid_embeddings)} images averaged."
        }

    except Exception as e:
        logger.error(f"Error enrolling with files: {e}")
        return JSONResponse(
            status_code=500,
            content={"success": False, "message": str(e)}
        )

# ----- Legacy Endpoints Removed -----

@app.delete("/api/students/{student_id}")
async def delete_student(student_id: str):
    """Deactivate a student (MongoDB)"""
    try:
        # Use MongoDB
        success = await mongodb.delete_student(student_id)
        if success:
            face_recognizer.remove_student(student_id)
            return {"success": True, "message": "Student deleted"}
        return {"success": False, "message": "Student not found"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

