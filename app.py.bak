@app.post("/api/settings")
async def update_settings_api(
    lectures: str = Form(default="[]"),
    start_time: str = Form(default=None), # Backward compat
    late_buffer: int = Form(default=None),
    absent_buffer: int = Form(default=None)
):
    """Update settings."""
    try:
        import json
        lectures_list = json.loads(lectures)
        success = await mongodb.update_settings(lectures=lectures_list)
        return {"success": success}
    except Exception as e:
        logger.error(f"Error updating settings: {e}")
        return {"success": False, "error": str(e)}


