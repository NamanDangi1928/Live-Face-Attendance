@app.get("/api/attendance/today")
async def get_today_attendance():
    """Get today's attendance records."""
    try:
        records = await mongodb.get_today_attendance()
        # Convert ObjectId and datetime to string
        for r in records:
            r["_id"] = str(r["_id"])
            if "student_id" in r:
                r["student_id"] = str(r["student_id"])
            if "check_in_time" in r and r["check_in_time"]:
                r["entry_time"] = r["check_in_time"].isoformat()
        return records
    except Exception as e:
        logger.error(f"Error getting today's attendance: {e}")
        return []


@app.post("/api/attendance/manual")
async def manual_attendance(
    student_id: str = Form(...),
    status: str = Form(...) # present, late, absent
):
    """Manually update attendance status."""
    try:
        # Determine context (optional, but good for multi-lecture)
        current_lecture, _ = await mongodb.get_current_lecture_status()
        
        # If explicitly marking absent on a dashboard, we might want to target *which* lecture?
        # For now, let's target the current context or default to today-generic if none.
        # But if the user is scrolling through a list and clicks "Absent", it might update the *existing* record 
        # for today regardless of lecture? 
        # mark_attendance handles "find existing => update status". 
        # So passing current_lecture ensures we find the RIGHT record if it exists.
        
        record = await mongodb.mark_attendance(
            student_id=student_id,
            confidence=1.0, # Manual is 100% confidence
            auto_detected=False,
            camera="manual",
            status=status,
            lecture=current_lecture
        )
        
        if record:
             # Broadcast update so dashboard reflects it immediately
             msg = {
                "type": "new_attendance",
                "name": str(student_id), # We might need name here, currently ID
                "status": status,
                "lecture": current_lecture,
                "timestamp": datetime.utcnow().isoformat()
             }
             await manager.broadcast_to_room("dashboard", msg)
             return {"success": True, "message": f"Marked as {status}"}
        else:
             # Should not happen because mark_attendance returns the record
             return {"success": False, "detail": "Failed to update record"}
             
    except Exception as e:
        logger.error(f"Error manually marking attendance: {e}")
        return {"success": False, "detail": str(e)}


