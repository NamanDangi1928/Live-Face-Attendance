<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analysis - Smart Attendance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/modern.css">
    <script>
        const storedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', storedTheme);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: var(--spacing-xl);
        }

        .chart-card {
            background: var(--bg-secondary);
            border-radius: var(--radius-xl);
            padding: var(--spacing-lg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-card);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .chart-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

        .chart-card-title {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: var(--spacing-lg);
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .chart-container {
            height: 320px;
            position: relative;
        }

        /* Full width for engagement chart */
        .chart-card.full-width {
            grid-column: 1 / -1;
        }

        .chart-card.full-width .chart-container {
            height: 380px;
        }

        /* Attendance chart special styling */
        .chart-card:first-child {
            background: linear-gradient(145deg, var(--bg-secondary), var(--bg-tertiary, var(--bg-secondary)));
        }
    </style>
</head>

<body>
    <div class="bg-pattern"></div>

    <!-- Sidebar Navigation -->
    <nav class="nav-bar">
        <div class="nav-logo">
            <img src="/static/images/logo.svg" alt="Eye-X">
        </div>
        <a href="/dashboard" class="nav-link"><span>Dashboard</span></a>
        <a href="/add-students" class="nav-link"><span>Add Students</span></a>
        <a href="/analysis" class="nav-link active"><span>Analysis</span></a>
        <a href="/data" class="nav-link"><span>Data</span></a>
        <a href="/settings" class="nav-link"><span>Settings</span></a>
    </nav>

    <!-- Main Content -->
    <div class="page-content">
        <div class="page-header">
            <h1 class="page-title">Analytics & Insights</h1>
            <p style="color: var(--text-secondary); margin-top: var(--spacing-sm);">
                Attendance trends and engagement analysis
            </p>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value" id="stat-today">--</div>
                <div class="stat-label">Present Today</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="stat-total">--</div>
                <div class="stat-label">Total Students</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="stat-rate">--</div>
                <div class="stat-label">Attendance Rate</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="stat-engagement">--</div>
                <div class="stat-label">Avg Engagement</div>
            </div>
        </div>

        <!-- Charts -->
        <div class="chart-grid">
            <div class="chart-card">
                <div class="chart-card-title">Attendance Trend (7 Days)</div>
                <div class="chart-container">
                    <canvas id="attendance-chart"></canvas>
                </div>
            </div>
            <div class="chart-card full-width">
                <div class="chart-card-title">Hourly Engagement Trend (Today)</div>
                <div class="chart-container">
                    <canvas id="hourly-engagement-chart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script>
        let attendanceChart = null;
        let engagementChart = null;

        document.addEventListener('DOMContentLoaded', () => {
            initCharts();
            loadData();
        });

        function initCharts() {
            const chartDefaults = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: { color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#a1a1aa' }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#a1a1aa' },
                        grid: { color: getComputedStyle(document.documentElement).getPropertyValue('--border-color') || '#27272a' }
                    },
                    y: {
                        ticks: { color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#a1a1aa' },
                        grid: { color: getComputedStyle(document.documentElement).getPropertyValue('--border-color') || '#27272a' }
                    }
                }
            };

            // Attendance Trend Chart - Enhanced UI
            const attendanceCtx = document.getElementById('attendance-chart').getContext('2d');

            // Create gradient for Present line
            const presentGradient = attendanceCtx.createLinearGradient(0, 0, 0, 300);
            presentGradient.addColorStop(0, 'rgba(16, 185, 129, 0.4)');
            presentGradient.addColorStop(1, 'rgba(16, 185, 129, 0.02)');

            // Create gradient for Absent line
            const absentGradient = attendanceCtx.createLinearGradient(0, 0, 0, 300);
            absentGradient.addColorStop(0, 'rgba(239, 68, 68, 0.3)');
            absentGradient.addColorStop(1, 'rgba(239, 68, 68, 0.02)');

            attendanceChart = new Chart(attendanceCtx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Present',
                        data: [],
                        borderColor: '#10b981',
                        backgroundColor: presentGradient,
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 6,
                        pointHoverRadius: 10,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: '#10b981',
                        pointHoverBorderWidth: 3
                    }, {
                        label: 'Absent',
                        data: [],
                        borderColor: '#ef4444',
                        backgroundColor: absentGradient,
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        pointBackgroundColor: '#ef4444',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: '#ef4444',
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    ...chartDefaults,
                    animation: {
                        duration: 1000,
                        easing: 'easeOutQuart'
                    },
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        ...chartDefaults.plugins,
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleFont: { size: 14, weight: 'bold' },
                            bodyFont: { size: 13 },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: true,
                            boxPadding: 6
                        },
                        legend: {
                            labels: {
                                color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#a1a1aa',
                                font: { size: 13, weight: '500' },
                                padding: 20,
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#a1a1aa',
                                font: { size: 12, weight: '500' }
                            },
                            grid: {
                                color: getComputedStyle(document.documentElement).getPropertyValue('--border-color') || '#27272a',
                                lineWidth: 0.5
                            }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary') || '#a1a1aa',
                                font: { size: 12 },
                                stepSize: 5
                            },
                            grid: {
                                color: getComputedStyle(document.documentElement).getPropertyValue('--border-color') || '#27272a',
                                lineWidth: 0.5
                            }
                        }
                    }
                }
            });

            // Hourly Engagement Chart
            engagementChart = new Chart(document.getElementById('hourly-engagement-chart'), {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        {
                            label: 'Focused + Studying',
                            data: [],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.15)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 3
                        },
                        {
                            label: 'Distracted',
                            data: [],
                            borderColor: '#f59e0b',
                            backgroundColor: 'rgba(245, 158, 11, 0.1)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 2
                        },
                        {
                            label: 'Sleeping',
                            data: [],
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    ...chartDefaults,
                    plugins: {
                        ...chartDefaults.plugins,
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    interaction: {
                        mode: 'nearest',
                        axis: 'x',
                        intersect: false
                    }
                }
            });
        }

        async function loadData() {
            // Load attendance trend
            try {
                const trendRes = await fetch('/api/analytics/attendance-trend?days=7');
                const trend = await trendRes.json();
                if (trend.data) {
                    attendanceChart.data.labels = trend.data.map(d => d.date);
                    attendanceChart.data.datasets[0].data = trend.data.map(d => d.present);
                    attendanceChart.data.datasets[1].data = trend.data.map(d => d.absent);
                    attendanceChart.update();
                }
            } catch (e) { console.error('Trend error:', e); }

            // Load today stats
            try {
                const statsRes = await fetch('/api/stats/today');
                const stats = await statsRes.json();

                document.getElementById('stat-today').textContent = stats.present || 0;
                document.getElementById('stat-total').textContent = stats.total || '--';

                const rate = stats.total > 0 ? Math.round((stats.present / stats.total) * 100) : 0;
                document.getElementById('stat-rate').textContent = rate + '%';
            } catch (e) {
                console.error('Stats error:', e);
            }

            // Load Hourly Engagement Data
            try {
                const hRes = await fetch('/api/analytics/hourly-behavior');
                const hData = await hRes.json();

                if (hData.success && hData.data && hData.data.length > 0) {
                    const hours = hData.data.map(d => `${d._id}:00`);

                    // Calculate engagement scores
                    const focusedData = hData.data.map(d => (d.focused || 0) + (d.studying || 0));
                    const distractedData = hData.data.map(d => d.distracted || 0);
                    const sleepingData = hData.data.map(d => d.sleeping || 0);

                    engagementChart.data.labels = hours;
                    engagementChart.data.datasets[0].data = focusedData;
                    engagementChart.data.datasets[1].data = distractedData;
                    engagementChart.data.datasets[2].data = sleepingData;
                    engagementChart.update();

                    // Calculate average engagement
                    const totalFocused = focusedData.reduce((a, b) => a + b, 0);
                    const totalAll = totalFocused + distractedData.reduce((a, b) => a + b, 0) + sleepingData.reduce((a, b) => a + b, 0);
                    const avgEngagement = totalAll > 0 ? Math.round((totalFocused / totalAll) * 100) : 0;
                    document.getElementById('stat-engagement').textContent = avgEngagement + '%';
                } else {
                    document.getElementById('stat-engagement').textContent = 'N/A';
                }
            } catch (e) {
                console.error('Hourly error:', e);
                document.getElementById('stat-engagement').textContent = 'N/A';
            }
        }
    </script>
</body>

</html>